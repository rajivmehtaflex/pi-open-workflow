{
  "name": "pi-open-workflow",
  "version": "0.1.7",
  "description": "Full open-source agentic workflow experience for Pi: Plan Mode, 5-mode safety gating, post-edit test verification loop, cascading CLAUDE.md/AGENTS.md memory, smart compaction, subagent Task tool, and semantic git commands.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Rajiv Mehta <rajiv.mehta@live.in>",
  "homepage": "https://github.com/rajivmehtaflex/pi-open-workflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajivmehtaflex/pi-open-workflow.git"
  },
  "bugs": {
    "url": "https://github.com/rajivmehtaflex/pi-open-workflow/issues"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./types": "./dist/src/types.js",
    "./db/task-store": "./dist/src/db/task-store.js"
  },
  "files": [
    "dist",
    "src",
    "skills",
    "prompts",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test \"src/**/*.test.ts\" \"test/**/*.test.ts\""
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/"
    ],
    "prompts": [
      "./prompts/*.md"
    ]
  },
  "dependencies": {
    "pi-mcp-adapter": "^2.26.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
